# ShipStudio metadata
.shipstudio/

# Claude no Space: chave da ponte e as páginas baixadas dos projetos (o que vale está na conta)
/.space/

# Pack Section Express importado (npm run sections:import): 46 MB, conteúdo licenciado
/data/section-express/

# Prospecção (npm run prospectar e a tela /prospeccao): contatos de empresas e pessoas, ficam só neste computador
/data/prospeccao/

# Criativos de campanha (artifacts/criativos-arquitetos): mídia e zips ficam só neste computador; scripts e textos seguem no git
*.zip
/artifacts/criativos-arquitetos/estaticos/
/artifacts/criativos-arquitetos/videos/
/artifacts/criativos-arquitetos/cases/
/artifacts/criativos-arquitetos/comercial/
/artifacts/criativos-arquitetos/frames/
/artifacts/criativos-arquitetos/frames-pb-*/
/artifacts/criativos-arquitetos/capturas/
/artifacts/criativos-arquitetos/capturas-cases/
/artifacts/criativos-arquitetos/quadros/
/artifacts/criativos-arquitetos/*.mp4
/artifacts/criativos-arquitetos/*.png
/artifacts/criativos-arquitetos/log-*.txt
/artifacts/criativos-arquitetos/comercial-e-processbase/
/artifacts/criativos-arquitetos/posts-feed-cases/
/artifacts/criativos-arquitetos/criativos-arquitetos-avence/

# Estado local do Supabase CLI (credenciais ficam no Keychain)
/supabase/.temp/
/supabase/.branches/

# Configuração local, credenciais e ferramentas deste computador
/.env
/.env.*
!/.env.example
/.codex/

# Temporários, runtimes baixados e perfis de navegador
/.tmp/
/.tmp-*/
/tmp/
/work/
/outputs/
__pycache__/
*.py[cod]
*.tsbuildinfo
/coverage/
/playwright-report/
/test-results/

# npm é o gerenciador do app; evitar locks concorrentes
/bun.lock
/bun.lockb

# Renderizações e capturas: manter fontes/textos, não o material gerado
/artifacts/**/*.png
/artifacts/**/*.jpg
/artifacts/**/*.jpeg
/artifacts/**/*.webp
/artifacts/**/*.gif
/artifacts/**/*.mp4
/artifacts/**/*.mov
/artifacts/**/*.webm

